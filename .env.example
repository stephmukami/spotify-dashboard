# Copy to .env.local and fill in. Never commit .env.local.
# On Vercel, set the same variables under Project → Settings → Environment Variables
# for Production, Preview and Development, then redeploy.

# Neon Postgres connection string (pooled). The Vercel Neon integration may name it
# DB_DATABASE_URL instead; the API accepts either.
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Signs the session cookie. Random string, at least 32 characters.
# Generate one with: openssl rand -base64 48
SESSION_SECRET=
