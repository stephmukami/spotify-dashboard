{
  "name": "spotify-project",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:full": "vercel dev --listen 127.0.0.1:3000",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest run",
    "db:push": "drizzle-kit push",
    "seed": "tsx --env-file=.env.local scripts/seed.ts",
    "seed:clear": "tsx --env-file=.env.local scripts/seed.ts --clear"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.2.1",
    "drizzle-orm": "^0.45.4",
    "graphology": "^0.26.0",
    "graphology-communities-louvain": "^2.0.2",
    "jose": "^6.2.18",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-force-graph-2d": "^1.29.2",
    "react-router": "^7.9.4",
    "react-router-dom": "^7.9.4"
  },
  "devDependencies": {
    "@eslint/js": "^9.36.0",
    "@types/node": "^24.6.0",
    "@types/react": "^19.1.16",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react-swc": "^4.1.0",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9.36.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.22",
    "globals": "^16.4.0",
    "graphology-types": "^0.24.8",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.45.0",
    "vite": "^7.1.7",
    "vitest": "^5.1.1"
  }
